# Variables d'environnement pour la connexion à la base de données.
# En local (Laragon), le code a déjà des valeurs par défaut (voir app/Core/Database.php),
# donc ce fichier n'est pas obligatoire pour faire tourner le projet chez toi.
# Il documente juste les variables à définir si le projet est déployé
# sur une plateforme comme Clever Cloud (add-on MySQL).

MYSQL_ADDON_HOST=localhost
MYSQL_ADDON_DB=mybad
MYSQL_ADDON_USER=root
MYSQL_ADDON_PASSWORD=
MYSQL_ADDON_PORT=3306
